<!DOCTYPE html>
<html lang="es-AR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="robots" content="noindex, nofollow">
<meta name="theme-color" content="#0A0A0A">
<title>Pantalla QR · Asistencia Zeppelin</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Oswald:wght@400;500&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<style>
:root{--neg:#0A0A0A;--nar:#FF5A00;--gris:#9A9A94;--bad:#FF6B5B}
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%}
body{background:var(--neg);color:#fff;font-family:'Oswald','Arial Narrow',Arial,sans-serif;overflow:hidden;padding:env(safe-area-inset-top,0px) env(safe-area-inset-right,0px) env(safe-area-inset-bottom,0px) env(safe-area-inset-left,0px)}
.hide{display:none!important}
#vista{height:100%;display:grid;grid-template-columns:1fr auto;gap:5vmin;align-items:center;padding:5vmin 6vmin}
.izq h1{font-family:'Bebas Neue',Impact,sans-serif;font-weight:400;font-size:clamp(48px,11vmin,140px);line-height:.88;letter-spacing:1px}
.izq h1 em{font-style:normal;color:var(--nar)}
.reloj{font-family:'Bebas Neue',Impact,sans-serif;font-size:clamp(56px,16vmin,200px);line-height:.9;margin-top:4vmin}
.fecha{color:var(--gris);font-size:clamp(16px,2.6vmin,30px);text-transform:capitalize}
.pasos{list-style:none;margin-top:5vmin;display:grid;gap:1.6vmin;font-size:clamp(16px,2.8vmin,32px);color:#E6E6E1}
.pasos b{color:var(--nar);font-family:'Bebas Neue',Impact,sans-serif;font-weight:400;font-size:1.3em;margin-right:.4em}
.der{display:flex;flex-direction:column;align-items:center}
.qrbox{background:#fff;padding:3vmin;border-radius:2vmin}
#qr img,#qr canvas{display:block;width:min(62vmin,70vh)!important;height:min(62vmin,70vh)!important}
.barra{width:100%;height:1.2vmin;min-height:6px;background:#2A2A28;border-radius:1vmin;margin-top:2.5vmin;overflow:hidden}
.barra i{display:block;height:100%;background:var(--nar);width:100%;transform-origin:left;transition:transform 1s linear}
.nota{color:var(--gris);font-size:clamp(13px,2vmin,22px);margin-top:1.5vmin;text-align:center}
.alerta{color:var(--bad)}
#par{height:100%;display:flex;align-items:center;justify-content:center;padding:24px}
#par .box{max-width:440px;width:100%}
#par h2{font-family:'Bebas Neue',Impact,sans-serif;font-weight:400;font-size:44px;line-height:1;margin-bottom:10px}
#par p{color:var(--gris);line-height:1.5;margin-bottom:16px}
#par input{width:100%;font:inherit;font-size:20px;padding:12px 14px;border-radius:6px;border:1.5px solid #3A3A37;background:#151514;color:#fff}
#par button,.fs{font:inherit;font-size:18px;font-weight:500;border:none;border-radius:6px;padding:12px 18px;background:var(--nar);color:#fff;cursor:pointer}
#par button{width:100%;margin-top:12px}
.fs{position:fixed;right:16px;bottom:calc(16px + env(safe-area-inset-bottom,0px));font-size:14px;padding:8px 12px;background:#222220;color:#ccc}
#err{color:var(--bad);margin-top:10px;min-height:1.4em}
@media (orientation:portrait){
  #vista{grid-template-columns:1fr;grid-template-rows:auto 1fr;text-align:center;gap:3vh;padding:4vh 5vw}
  .pasos{display:none}
  .reloj{margin-top:1vh}
  #qr img,#qr canvas{width:min(82vw,58vh)!important;height:min(82vw,58vh)!important}
}
</style>
</head>
<body>

<div id="par" class="hide">
  <div class="box">
    <h2>Vincular pantalla</h2>
    <p>Ingresá la clave de la pantalla. La encontrás en el panel de asistencia, en Configuración. Se pide una sola vez en este dispositivo.</p>
    <input id="clave" type="password" autocomplete="off" placeholder="Clave de la pantalla">
    <button id="bPar">Vincular</button>
    <div id="err"></div>
  </div>
</div>

<div id="vista" class="hide">
  <div class="izq">
    <h1>Marcá tu<br><em>asistencia</em></h1>
    <div class="reloj" id="reloj">--:--</div>
    <div class="fecha" id="fecha"></div>
    <ol class="pasos">
      <li><b>1</b>Abrí la cámara del celular</li>
      <li><b>2</b>Escaneá el código y tocá el enlace</li>
      <li><b>3</b>Tocá Ingreso o Egreso</li>
    </ol>
  </div>
  <div class="der">
    <div class="qrbox"><div id="qr"></div></div>
    <div class="barra"><i id="barra"></i></div>
    <div class="nota" id="nota">El código cambia cada 30 segundos</div>
  </div>
</div>

<button class="fs hide" id="bFs">Pantalla completa</button>

<script>
const API = 'https://script.google.com/macros/s/AKfycby5KUw7KKL1WYv95fA3VbfNNPbOgJiakDjDEB_L1gR59XNMZKBGyassvPNbkc4I3q1o/exec';
const STAFF_URL = 'https://zeppelin-bar.com/asistencia/';
const VENTANA = 30000;
const LS = 'zpp_pantalla_secreto';
const $ = id => document.getElementById(id);

let secreto = null, clave = null, offset = 0, qr = null, ventanaActual = -1, sinHora = false;
try { secreto = localStorage.getItem(LS); } catch (e) {}

// Vinculación rápida desde el panel: pantalla/#s=CLAVE
(function () {
  const m = location.hash.match(/s=([^&]+)/);
  if (m) {
    secreto = decodeURIComponent(m[1]);
    try { localStorage.setItem(LS, secreto); } catch (e) {}
    try { history.replaceState(null, '', location.pathname); } catch (e) {}
  }
})();

async function firma(ventana) {
  const sig = await crypto.subtle.sign('HMAC', clave, new TextEncoder().encode(String(ventana)));
  return [...new Uint8Array(sig)].map(b => b.toString(16).padStart(2, '0')).join('').slice(0, 12);
}

async function sincronizarHora() {
  const ctrl = new AbortController();
  const t = setTimeout(() => ctrl.abort(), 15000);
  try {
    const t0 = Date.now();
    const r = await fetch(API + '?action=ping', { signal: ctrl.signal });
    const j = await r.json();
    const t1 = Date.now();
    if (j.ok && j.epoch) { offset = j.epoch - Math.round((t0 + t1) / 2); sinHora = false; }
  } catch (e) { sinHora = true; }
  finally { clearTimeout(t); }
}

const ahora = () => Date.now() + offset;

async function claveCorrecta() {
  try {
    const v = Math.floor(ahora() / VENTANA);
    const r = await fetch(API + '?action=qr_check&q=' + v + '.' + (await firma(v)));
    const j = await r.json();
    return !(j.ok && j.valido === false);
  } catch (e) { return true; }   // sin conexión: no bloquear la pantalla
}

async function tick() {
  const n = ahora();
  const d = new Date(n);
  $('reloj').textContent = d.toLocaleTimeString('es-AR', { hour: '2-digit', minute: '2-digit', hour12: false });
  $('fecha').textContent = d.toLocaleDateString('es-AR', { weekday: 'long', day: 'numeric', month: 'long' });
  const v = Math.floor(n / VENTANA);
  const resto = 1 - (n % VENTANA) / VENTANA;
  $('barra').style.transform = 'scaleX(' + resto.toFixed(3) + ')';
  if (v !== ventanaActual) {
    ventanaActual = v;
    const url = STAFF_URL + '?q=' + v + '.' + (await firma(v));
    if (qr) qr.clear(), qr.makeCode(url);
    else qr = new QRCode($('qr'), { text: url, width: 600, height: 600, colorDark: '#0A0A0A', colorLight: '#FFFFFF', correctLevel: QRCode.CorrectLevel.M });
  }
  $('nota').className = 'nota' + (sinHora ? ' alerta' : '');
  $('nota').textContent = sinHora ? 'Sin conexión: usando la hora de este dispositivo' : 'El código cambia cada 30 segundos';
}

async function mantenerEncendida() {
  try { if ('wakeLock' in navigator) await navigator.wakeLock.request('screen'); } catch (e) {}
}

async function iniciar() {
  if (!window.crypto || !crypto.subtle) { document.body.innerHTML = '<p style="padding:24px">Este navegador no soporta la firma del código. Usá Chrome actualizado.</p>'; return; }
  if (typeof QRCode === 'undefined') { document.body.innerHTML = '<p style="padding:24px">No se pudo cargar el generador de QR. Revisá la conexión y recargá.</p>'; return; }
  if (!secreto) { $('par').classList.remove('hide'); $('clave').focus(); return; }
  clave = await crypto.subtle.importKey('raw', new TextEncoder().encode(secreto), { name: 'HMAC', hash: 'SHA-256' }, false, ['sign']);
  $('par').classList.add('hide');
  $('vista').classList.remove('hide');
  $('bFs').classList.toggle('hide', !document.documentElement.requestFullscreen);
  await sincronizarHora();
  if (!(await claveCorrecta())) {
    try { localStorage.removeItem(LS); } catch (e) {}
    secreto = null;
    $('vista').classList.add('hide');
    $('par').classList.remove('hide');
    $('err').textContent = 'La clave no coincide con la del panel. Copiala de nuevo desde Configuración.';
    return;
  }
  await tick();
  setInterval(tick, 1000);
  setInterval(sincronizarHora, 10 * 60000);
  mantenerEncendida();
  document.addEventListener('visibilitychange', () => { if (!document.hidden) mantenerEncendida(); });
}

$('bPar').onclick = () => {
  const v = $('clave').value.trim();
  if (v.length < 10) { $('err').textContent = 'La clave no es válida.'; return; }
  secreto = v;
  try { localStorage.setItem(LS, v); } catch (e) {}
  iniciar();
};
$('clave').addEventListener('keydown', e => { if (e.key === 'Enter') $('bPar').click(); });
$('bFs').onclick = () => { document.documentElement.requestFullscreen().catch(() => {}); };
document.addEventListener('fullscreenchange', () => $('bFs').classList.toggle('hide', !!document.fullscreenElement));

iniciar();
</script>
</body>
</html>
